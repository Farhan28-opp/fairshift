# FairShift configuration. Copy to .env for local use; never commit real values.
# No secrets are required: Firestore on Cloud Run uses the service account.

# Port the server listens on (Cloud Run and Vercel set this automatically)
PORT=8080
# production | development
NODE_ENV=development
# true = load demo data and show sign-in codes on screen (no SMS gateway is wired in)
DEMO_MODE=true
# Storage driver: firestore (Cloud Run), file (local or Vercel /tmp), memory (tests)
STORAGE=file
# JSON file used when STORAGE=file (use /tmp/fairshift.json on Vercel)
DATA_FILE=./data/fairshift.json
# Optional Firestore database id (default database when empty)
FIRESTORE_DATABASE=
# Hours before demo data is re-seeded (0 = never)
DEMO_RESET_HOURS=24
# debug | info | warn | error
LOG_LEVEL=info
