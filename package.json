{
  "name": "fairshift",
  "version": "1.0.0",
  "description": "FairShift: a decent-work platform (UN SDG 8). Shift records, explained payslips, pay disputes, anonymous safety and grievance cases with deadlines and an audit trail, and a rule-based Fairness Radar for employers. Tamil and English.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "DEMO_MODE=true node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "license": "MIT"
}
